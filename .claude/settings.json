{
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(py *)",
      "Bash(.venv/Scripts/python *)",
      "Bash(ruff *)",
      "Bash(.venv/Scripts/ruff *)",
      "Bash(sqlite3 *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/ruff_format.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  }
}
